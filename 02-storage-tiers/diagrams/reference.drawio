        <mxCell id="sas" value="&lt;b&gt;Anyone with the SAS URL&lt;/b&gt;&lt;br&gt;user delegation SAS, signed with Entra&lt;br&gt;read report-hot · 1 hour · HTTPS only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;fontSize=11;" vertex="1" parent="1">
