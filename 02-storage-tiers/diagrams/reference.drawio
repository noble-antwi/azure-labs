          <mxGeometry x="305" y="405" width="330" height="45" as="geometry" />
        </mxCell>

        <!-- Lifecycle management -->
        <mxCell id="lcm" value="&lt;b&gt;Lifecycle management&lt;/b&gt;&lt;br&gt;tier-by-age: Cool 30 d · Archive 180 d&lt;br&gt;fast-demo (prefix tiers/lc-): Cool 1 d · Cold 2 d · Archive 3 d&lt;br&gt;&lt;i&gt;runs once a day&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#C19C00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="560" width="360" height="80" as="geometry" />
