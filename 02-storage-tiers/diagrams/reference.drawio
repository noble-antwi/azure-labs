        </mxCell>
        <mxCell id="b-hot" value="&lt;b&gt;report-hot&lt;/b&gt;&lt;br&gt;Hot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#C50F1F;fontSize=11;" vertex="1" parent="1">
