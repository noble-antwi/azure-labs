          <mxGeometry x="305" y="295" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-arch" value="&lt;b&gt;report-archive&lt;/b&gt;&lt;br&gt;Archive, rehydrated High: ~37 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE9;strokeColor=#605E5C;fontSize=11;" vertex="1" parent="1">
