<mxfile host="app.diagrams.net">
  <diagram name="Lab 02 reference" id="lab02-reference">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Lab 02: Storage tiers&lt;/b&gt;&lt;br&gt;REFERENCE. Draw your own as architecture.drawio" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
