        <!-- Storage account -->
        <mxCell id="sa" value="&lt;b&gt;stlabtiersnoble01&lt;/b&gt;&lt;br&gt;StorageV2 · Standard LRS&lt;br&gt;default tier: Hot&lt;br&gt;&lt;font color=&quot;#C50F1F&quot;&gt;key access OFF&lt;/font&gt;&lt;br&gt;anonymous access OFF · TLS 1.2" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/storage/Storage_Accounts.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="250" width="64" height="52" as="geometry" />
